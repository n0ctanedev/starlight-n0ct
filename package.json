{
  "name": "@n0ctanedev/starlight-n0ct",
  "version": "1.0.0",
  "description": "A polished theme, component system, and project installer for Astro Starlight",
  "type": "module",
  "license": "MIT",
  "author": "N0ctane._.Dev",
  "homepage": "https://n0ctanedev.github.io/starlight-n0ct",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n0ctanedev/starlight-n0ct.git"
  },
  "bugs": {
    "url": "https://github.com/n0ctanedev/starlight-n0ct/issues"
  },
  "keywords": [
    "astro",
    "starlight",
    "starlight-theme",
    "documentation",
    "n0ctos",
    "neon",
    "starter-template",
    "project-scaffolder",
    "installer"
  ],
  "sideEffects": [
    "dist/styles/theme.css"
  ],
  "files": [
    "assets/**",
    "dist/**",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "bin/**",
    "templates/**"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": "./dist/components/*",
    "./styles.css": "./dist/styles/theme.css",
    "./package.json": "./package.json",
    "./theme-playground": {
      "types": "./dist/theme-playground.d.ts",
      "import": "./dist/theme-playground.js"
    }
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build": "npm run clean && tsup && tsup --config tsup.playground.config.ts && node ./scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:install": "npm --prefix docs install --no-audit --no-fund",
    "docs:dev": "npm run build && npm run docs:install && npm --prefix docs run dev",
    "docs:build": "npm run build && npm run docs:install && npm run docs:build:site",
    "check": "node --check bin/n0ct.mjs && node --check bin/add-feature.mjs && node --check scripts/check-templates.mjs && npm run typecheck && npm test && npm run build",
    "check:all": "npm run check && npm run docs:install && npm run docs:build:site && npm run templates:check && npm run audit:full",
    "prepack": "npm run build",
    "audit": "node ./scripts/audit-deps.mjs",
    "docs:build:site": "npm --prefix docs run build && node ./scripts/check-code-tabs-build.mjs",
    "check:ci": "npm run check:all && npm pack --dry-run",
    "security:check": "node ./scripts/audit-deps.mjs",
    "audit:full": "node ./scripts/audit-deps.mjs",
    "templates:check": "node scripts/check-templates.mjs"
  },
  "dependencies": {
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@fontsource-variable/space-grotesk": "^5.2.6",
    "@fontsource/space-mono": "^5.2.6",
    "@iconify-json/lucide": "^1.2.155",
    "@tailwindcss/vite": "^4.3.5",
    "astro-icon": "^1.2.0",
    "starlight-announcement": "^2.0.0",
    "starlight-base-path": "^0.2.1",
    "starlight-blog": "^0.30.2",
    "starlight-codeblocks": "^1.4.1",
    "starlight-image-zoom": "^0.16.2",
    "starlight-kbd": "^0.4.0",
    "starlight-links-validator": "^0.27.0",
    "starlight-llm-actions": "^0.13.0",
    "starlight-llms-txt": "^0.12.0",
    "starlight-scroll-to-top": "^2.0.0",
    "starlight-sidebar-swipe": "^0.4.1",
    "starlight-sidebar-topics": "^0.9.0",
    "starlight-sidebar-topics-dropdown": "^0.7.0",
    "starlight-versions": "^0.10.2",
    "tailwindcss": "^4.3.5"
  },
  "peerDependencies": {
    "@astrojs/starlight": ">=0.42.0 <1.0.0",
    "@iconify-json/lucide": "^1.2.155",
    "astro": "^7.2.10"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.43.1",
    "@iconify-json/lucide": "^1.2.155",
    "@types/node": "^22.19.0",
    "astro": "^7.4.12",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "bin": {
    "n0ct": "bin/n0ct.mjs",
    "starlight-n0ct": "bin/n0ct.mjs"
  }
}
